# Server
SERVER_PORT=8080

# CORS: exact frontend origin (Angular dev server locally, the Vercel URL in production)
CORS_ALLOWED_ORIGIN=http://localhost:4200

# MongoDB
MONGODB_URI=mongodb://localhost:27017/orbit

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT (generate a secret with: openssl rand -hex 32)
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# Refresh cookie. Defaults suit production (cross-site, HTTPS).
# If a browser rejects the Secure cookie over plain http://localhost (Safari does, as far as I know),
# set COOKIE_SECURE=false and COOKIE_SAME_SITE=Lax for local testing.
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# Cloudflare R2 (optional until Phase 3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=orbit-dev
R2_PUBLIC_URL=

# Claude API (optional until Phase 4)
ANTHROPIC_API_KEY=

# Rate Limiting (overridden for test runs)
RATE_LIMIT_AUTH_PER_MINUTE=1000